# Reference for the environment variables KAVACH reads. The program does NOT load a .env file: set these in your
# host's settings (Render: service > Environment) or in your shell. Never commit real values.

# --- required on a hosted deployment (no browser setup: the first-admin page only works from the machine itself) ---
KAVACH_ADMIN_USER=analyst            # 3-32 chars: lower-case letters, digits, dot, dash, underscore; start with a letter or digit
KAVACH_ADMIN_PASSWORD=               # at least 10 characters. Only used when no account exists yet.

# --- safety ---
VAPT_LAB_ONLY=1                      # refuse allow_non_lab and authorized_domains: the deployment can only scan private/loopback lab targets

# --- language model (optional; with none set the agent runs on its rules engine). Use ONE provider. ---
# Groq, or any other OpenAI-compatible server:
VAPT_OPENAI_URL=https://api.groq.com/openai/v1   # a base URL ending in /v1: the program adds /chat/completions itself
VAPT_OPENAI_KEY=                     # a secret: type it into the host's dashboard, never into chat or git
VAPT_MODEL=                          # the exact model id, for example openai/gpt-oss-120b. Set it explicitly
# Claude instead (the program prefers it whenever ANTHROPIC_API_KEY is set, so leave this out when using Groq):
# ANTHROPIC_API_KEY=
# VAPT_MODEL=claude-sonnet-5-5       # default for Claude if unset
# VAPT_ANTHROPIC_URL=                # only for a gateway or test server
# A local model: OLLAMA_URL / OLLAMA_MODEL (used only when neither of the above is set)

# --- hosting ---
# VAPT_ALLOWED_HOSTS=demo.example.com   # extra public host name(s), comma separated, for a custom domain. Render's own
#                                       # <name>.onrender.com name is added automatically (from RENDER_EXTERNAL_HOSTNAME).
# VAPT_RUN_LAB=1                       # 1 = start the bundled vulnerable lab inside the container (default); 0 = console only
# VAPT_DATA=/data                      # where assessments, raw output and audit logs are written
# PORT=10000                           # set by Render; do not set it yourself there
